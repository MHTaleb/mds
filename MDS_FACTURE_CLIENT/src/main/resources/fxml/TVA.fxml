<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextField?>
<?import java.net.URL?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="stackPane" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mds.facture.client.dashboard.TVAController">
   <children>
      <AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass">
          <stylesheets>
              <URL value="@/styles/theme.css" />
          </stylesheets>
         <children>
            <TableView fx:id="tableTVA" layoutX="14.0" layoutY="14.0" prefHeight="343.0" prefWidth="200.0" tableMenuButtonVisible="true" AnchorPane.bottomAnchor="18.0" AnchorPane.leftAnchor="18.0" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="68.0">
              <columns>
                <TableColumn fx:id="columnTaux" prefWidth="75.0" text="Taux" />
                <TableColumn fx:id="columnNature" prefWidth="75.0" text="Nature" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_LEFT" layoutX="18.0" layoutY="18.0" spacing="25.0" AnchorPane.leftAnchor="18.0" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="18.0">
               <children>
                  <JFXTextField fx:id="searchText" focusColor="#837d7d" onKeyReleased="#doSearch" prefHeight="25.0" prefWidth="198.0" promptText="Recherche" unFocusColor="#b9b8b8" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Calibri" size="14.0" />
                     </font>
                  </JFXTextField>
                  <JFXButton onAction="#showAddTVA" prefHeight="32.0" prefWidth="92.0" styleClass="add" text="Ajouter" textFill="WHITE">
                     <font>
                        <Font name="Calibri" size="14.0" />
                     </font>
                  </JFXButton>
                  <JFXButton onAction="#showEditTVA" prefHeight="32.0" prefWidth="92.0" styleClass="update" text="Modifier" textFill="WHITE">
                     <font>
                        <Font name="Calibri" size="14.0" />
                     </font>
                  </JFXButton>
                  <JFXButton onAction="#doDeleteTVA" prefHeight="32.0" prefWidth="92.0" styleClass="delete" text="Supprimer" textFill="WHITE">
                     <font>
                        <Font name="Calibri" size="14.0" />
                     </font>
                  </JFXButton>
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </children>
</StackPane>
